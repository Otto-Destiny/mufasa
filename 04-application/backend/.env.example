# MUFASA application configuration.
#
#   cp .env.example .env
#
# Every value below has a working default, so an unedited copy starts. Nothing
# here may point at a network service other than 127.0.0.1: the evaluation runs
# with no internet, and one outbound request scores zero.

# ---------------------------------------------------------------- model ----
# Key from models.toml. Swap models without touching code.
#   gemma-3-270m | qwen3-1_7b | nanbeige-3b | mufasa
MUFASA_MODEL=qwen3-1_7b
MUFASA_MODELS_DIR=./models
MUFASA_MODEL_REGISTRY=./models.toml

# Prefer llama-server when the GGUF + binary are present. If either is missing,
# the app falls back to evidence-only answers automatically.
MUFASA_GENERATOR=llama-server
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_SERVER_BIN=./bin/llama-server

# ------------------------------------------------------- resource limits ----
# These prevent the only two failure modes that score zero: out of memory is
# disqualification, thermal throttling costs 10 marks.
MUFASA_MAX_CONTEXT_TOKENS=2048
MUFASA_MAX_OUTPUT_TOKENS=400
MUFASA_LLAMA_THREADS=4
MUFASA_SINGLE_FLIGHT=true
MUFASA_MAX_EVIDENCE_RECORDS=10

# ------------------------------------------------------------ retrieval ----
MUFASA_DB=../../packages/corpus_v1/mufasa.db
MUFASA_TOP_K=10
MUFASA_USE_VECTORS=true
# hashing = deterministic, no model file. onnx = a real encoder from a local dir.
MUFASA_EMBED_BACKEND=hashing
MUFASA_EMBED_MODEL_DIR=
MUFASA_EMBED_THREADS=2

# ---------------------------------------------------------------- voice ----
MUFASA_TTS_ENABLED=true
MUFASA_TTS_VOICE=en_US-lessac-medium
MUFASA_TTS_BIN=./bin/piper
MUFASA_VOICES_DIR=./voices

# --------------------------------------------------------------- server ----
MUFASA_HOST=127.0.0.1
MUFASA_PORT=8756
# Off by default. When enabled the laptop exposes one paired mobile session on
# the local network; turning it off revokes the token and closes the listener.
MUFASA_SHARE_LAN=false
MUFASA_FEEDBACK_PATH=./feedback.jsonl
